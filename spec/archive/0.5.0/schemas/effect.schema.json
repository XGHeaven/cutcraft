                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "default": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "r": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "default": 0
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "default": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "g": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "default": 0
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "default": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "b": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "default": 0
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "default": 0
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effectType": {
            "const": "builtin.lut"
          }
        },
        "required": [
          "effectType"
        ]
      },
      "then": {
        "required": [
          "version",
          "parameters"
        ],
        "properties": {
          "version": {
            "enum": [
              "1.0.0",
              "2.0.0"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "version": {
                  "const": "1.0.0"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "assetId": {
                      "$ref": "common.schema.json#/$defs/assetId"
                    },
                    "strength": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "default": 1
                    },
                    "inputColorSpace": {
                      "enum": [
                        "linear-srgb",
                        "srgb",
                        "rec709"
                      ]
                    },
                    "outputColorSpace": {
                      "enum": [
                        "linear-srgb",
                        "srgb",
                        "rec709"
                      ]
                    },
                    "interpolation": {
                      "enum": [
                        "linear",
                        "trilinear",
                        "tetrahedral"
                      ]
                    }
                  },
                  "required": [
                    "assetId",
                    "inputColorSpace",
                    "outputColorSpace",
                    "interpolation"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "else": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "assetId": {
                      "$ref": "common.schema.json#/$defs/assetId"
                    },
                    "strength": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "default": 1
                        },
                        {
                          "allOf": [
                            {
                              "$ref": "animation.schema.json#/$defs/numberAnimation"
