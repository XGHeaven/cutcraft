{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutstate.dev/schema/v0.5/effect.schema.json",
  "title": "Cutcraft built-in effects 0.5.0",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "effectType": {
            "const": "builtin.color-grade"
          }
        },
        "required": [
          "effectType"
        ]
      },
      "then": {
        "required": [
          "version",
          "parameters"
        ],
        "properties": {
          "version": {
            "enum": [
              "1.0.0",
              "2.0.0"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "version": {
                  "const": "1.0.0"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "exposureEv": {
                      "type": "number",
                      "minimum": -20,
                      "maximum": 20,
                      "default": 0
                    },
                    "temperature": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1,
                      "default": 0
                    },
                    "tint": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1,
                      "default": 0
                    },
                    "contrast": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 4,
                      "default": 1
                    },
                    "pivot": {
                      "type": "number",
                      "minimum": 1e-06,
                      "maximum": 1,
                      "default": 0.18
                    },
                    "saturation": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 4,
                      "default": 1
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              }
            },
            "else": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "exposureEv": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": -20,
                          "maximum": 20,
                          "default": 0
                        },
                        {
                          "allOf": [
                            {
                              "$ref": "animation.schema.json#/$defs/numberAnimation"
                            },
                            {
                              "properties": {
                                "$animation": {
                                  "properties": {
                                    "keyframes": {
                                      "items": {
                                        "properties": {
                                          "value": {
                                            "type": "number",
                                            "minimum": -20,
                                            "maximum": 20,
                                            "default": 0
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      ]
                    },
                    "temperature": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": -1,
                          "maximum": 1,
                          "default": 0
                        },
                        {
                          "allOf": [
                            {
                              "$ref": "animation.schema.json#/$defs/numberAnimation"
                            },
                            {
                              "properties": {
                                "$animation": {
                                  "properties": {
                                    "keyframes": {
                                      "items": {
                                        "properties": {
                                          "value": {
                                            "type": "number",
                                            "minimum": -1,
                                            "maximum": 1,
                                            "default": 0
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      ]
                    },
                    "tint": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": -1,
                          "maximum": 1,
                          "default": 0
                        },
                        {
                          "allOf": [
                            {
                              "$ref": "animation.schema.json#/$defs/numberAnimation"
                            },
                            {
                              "properties": {
                                "$animation": {
                                  "properties": {
                                    "keyframes": {
                                      "items": {
                                        "properties": {
                                          "value": {
                                            "type": "number",
                                            "minimum": -1,
                                            "maximum": 1,
                                            "default": 0
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      ]
                    },
                    "contrast": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 4,
                          "default": 1
                        },
                        {
                          "allOf": [
                            {
                              "$ref": "animation.schema.json#/$defs/numberAnimation"
                            },
                            {
                              "properties": {
                                "$animation": {
                                  "properties": {
                                    "keyframes": {
                                      "items": {
                                        "properties": {
                                          "value": {
                                            "type": "number",
                                            "minimum": 0,
                                            "maximum": 4,
                                            "default": 1
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      ]
                    },
                    "pivot": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 1e-06,
                          "maximum": 1,
                          "default": 0.18
                        },
                        {
                          "allOf": [
                            {
                              "$ref": "animation.schema.json#/$defs/numberAnimation"
                            },
                            {
                              "properties": {
                                "$animation": {
                                  "properties": {
                                    "keyframes": {
                                      "items": {
                                        "properties": {
                                          "value": {
                                            "type": "number",
                                            "minimum": 1e-06,
                                            "maximum": 1,
                                            "default": 0.18
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      ]
                    },
                    "saturation": {
                      "oneOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 4,
                          "default": 1
                        },
                        {
                          "allOf": [
                            {
                              "$ref": "animation.schema.json#/$defs/numberAnimation"
                            },
                            {
                              "properties": {
                                "$animation": {
                                  "properties": {
                                    "keyframes": {
                                      "items": {
                                        "properties": {
                                          "value": {
                                            "type": "number",
                                            "minimum": 0,
                                            "maximum": 4,
                                            "default": 1
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
