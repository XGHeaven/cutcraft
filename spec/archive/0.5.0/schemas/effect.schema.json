                        "srgb",
                        "rec709"
                      ]
                    },
                    "interpolation": {
                      "enum": [
                        "linear",
                        "trilinear",
                        "tetrahedral"
                      ]
                    }
                  },
                  "required": [
                    "assetId",
                    "inputColorSpace",
                    "outputColorSpace",
                    "interpolation"
                  ],
                  "additionalProperties": false
                }
              }
