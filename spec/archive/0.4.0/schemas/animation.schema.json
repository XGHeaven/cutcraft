{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutstate.dev/schema/v0.4/animation.schema.json",
  "title": "Cutcraft reusable animated values 0.4.0 draft",
  "oneOf": [
    {
      "$ref": "animation.schema.json#/$defs/numberAnimation"
    },
    {
      "$ref": "animation.schema.json#/$defs/vector2Animation"
    },
    {
      "$ref": "animation.schema.json#/$defs/colorAnimation"
    },
    {
      "$ref": "animation.schema.json#/$defs/booleanAnimation"
    },
    {
      "$ref": "animation.schema.json#/$defs/stringAnimation"
    },
    {
      "$ref": "animation.schema.json#/$defs/timeAnimation"
    }
  ],
  "$defs": {
    "easing": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "hold",
                "linear"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "x1",
            "y1",
            "x2",
            "y2"
          ],
          "properties": {
            "type": {
              "const": "cubic-bezier"
            },
            "x1": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y1": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "x2": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y2": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "numberAnimation": {
      "type": "object",
      "required": [
        "$animation"
      ],
      "properties": {
        "$animation": {
          "type": "object",
          "required": [
            "version",
            "valueType",
            "timeReference",
            "keyframes"
          ],
          "properties": {
            "version": {
              "const": "1.0.0"
            },
            "valueType": {
              "const": "number"
            },
            "timeReference": {
              "const": "owner"
            },
            "extrapolation": {
              "type": "object",
              "properties": {
                "before": {
                  "const": "hold"
                },
                "after": {
                  "const": "hold"
                }
              },
              "additionalProperties": false
            },
            "keyframes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "offset",
                  "value"
                ],
                "properties": {
                  "offset": {
                    "$ref": "common.schema.json#/$defs/time"
                  },
                  "value": {
                    "type": "number"
                  },
                  "easing": {
                    "$ref": "animation.schema.json#/$defs/easing"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "numberValue": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "animation.schema.json#/$defs/numberAnimation"
        }
      ]
    },
    "vector2Animation": {
      "type": "object",
      "required": [
        "$animation"
      ],
      "properties": {
        "$animation": {
          "type": "object",
          "required": [
            "version",
            "valueType",
            "timeReference",
            "keyframes"
          ],
          "properties": {
            "version": {
              "const": "1.0.0"
            },
            "valueType": {
              "const": "vector2"
            },
            "timeReference": {
              "const": "owner"
            },
            "extrapolation": {
              "type": "object",
              "properties": {
                "before": {
                  "const": "hold"
                },
                "after": {
                  "const": "hold"
                }
              },
              "additionalProperties": false
            },
            "keyframes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "offset",
                  "value"
                ],
                "properties": {
                  "offset": {
                    "$ref": "common.schema.json#/$defs/time"
                  },
                  "value": {
                    "type": "object",
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false
                  },
                  "easing": {
                    "$ref": "animation.schema.json#/$defs/easing"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "vector2Value": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "animation.schema.json#/$defs/vector2Animation"
        }
      ]
    },
    "colorAnimation": {
      "type": "object",
      "required": [
        "$animation"
      ],
      "properties": {
        "$animation": {
          "type": "object",
          "required": [
            "version",
            "valueType",
            "timeReference",
            "keyframes",
            "colorSpace"
          ],
          "properties": {
            "version": {
              "const": "1.0.0"
            },
            "valueType": {
              "const": "color"
            },
            "timeReference": {
              "const": "owner"
            },
            "extrapolation": {
              "type": "object",
              "properties": {
                "before": {
                  "const": "hold"
                },
                "after": {
                  "const": "hold"
                }
              },
              "additionalProperties": false
            },
            "keyframes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "offset",
                  "value"
                ],
                "properties": {
                  "offset": {
                    "$ref": "common.schema.json#/$defs/time"
                  },
                  "value": {
                    "type": "object",
                    "required": [
                      "r",
                      "g",
                      "b",
                      "a"
                    ],
                    "properties": {
                      "r": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "g": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "b": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "a": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "easing": {
                    "$ref": "animation.schema.json#/$defs/easing"
                  }
                },
                "additionalProperties": false
              }
            },
            "colorSpace": {
              "const": "linear-srgb"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "colorValue": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "r",
            "g",
            "b",
            "a"
          ],
          "properties": {
            "r": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "g": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "b": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "a": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "animation.schema.json#/$defs/colorAnimation"
        }
      ]
    },
    "booleanAnimation": {
      "type": "object",
      "required": [
        "$animation"
      ],
      "properties": {
        "$animation": {
          "type": "object",
          "required": [
            "version",
            "valueType",
            "timeReference",
            "keyframes"
          ],
          "properties": {
            "version": {
              "const": "1.0.0"
            },
            "valueType": {
              "const": "boolean"
            },
            "timeReference": {
              "const": "owner"
            },
            "extrapolation": {
              "type": "object",
              "properties": {
                "before": {
                  "const": "hold"
                },
                "after": {
                  "const": "hold"
                }
              },
              "additionalProperties": false
            },
            "keyframes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "offset",
                  "value"
                ],
                "properties": {
                  "offset": {
                    "$ref": "common.schema.json#/$defs/time"
                  },
                  "value": {
                    "type": "boolean"
                  },
                  "easing": {
                    "type": "object",
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "hold"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "booleanValue": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "animation.schema.json#/$defs/booleanAnimation"
        }
      ]
    },
    "stringAnimation": {
      "type": "object",
      "required": [
        "$animation"
      ],
      "properties": {
        "$animation": {
          "type": "object",
          "required": [
            "version",
            "valueType",
            "timeReference",
            "keyframes"
          ],
          "properties": {
            "version": {
              "const": "1.0.0"
            },
            "valueType": {
              "const": "string"
            },
            "timeReference": {
              "const": "owner"
            },
            "extrapolation": {
              "type": "object",
              "properties": {
                "before": {
                  "const": "hold"
                },
                "after": {
                  "const": "hold"
                }
              },
              "additionalProperties": false
            },
            "keyframes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "offset",
                  "value"
                ],
                "properties": {
                  "offset": {
                    "$ref": "common.schema.json#/$defs/time"
                  },
                  "value": {
                    "type": "string"
                  },
                  "easing": {
                    "type": "object",
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "hold"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "stringValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "animation.schema.json#/$defs/stringAnimation"
        }
      ]
    },
    "timeAnimation": {
      "type": "object",
      "required": [
        "$animation"
      ],
      "properties": {
        "$animation": {
          "type": "object",
          "required": [
            "version",
            "valueType",
            "timeReference",
            "keyframes"
          ],
          "properties": {
            "version": {
              "const": "1.0.0"
            },
            "valueType": {
              "const": "time"
            },
            "timeReference": {
              "const": "owner"
            },
            "extrapolation": {
              "type": "object",
              "properties": {
                "before": {
                  "const": "hold"
                },
                "after": {
                  "const": "hold"
                }
              },
              "additionalProperties": false
            },
            "keyframes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "offset",
                  "value"
                ],
                "properties": {
                  "offset": {
                    "$ref": "common.schema.json#/$defs/time"
                  },
                  "value": {
                    "$ref": "common.schema.json#/$defs/time"
                  },
                  "easing": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "const": "linear"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "outRate",
                          "inRate"
                        ],
                        "properties": {
                          "type": {
                            "const": "cubic-hermite"
                          },
                          "outRate": {
                            "$ref": "common.schema.json#/$defs/rational"
                          },
                          "inRate": {
                            "$ref": "common.schema.json#/$defs/rational"
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "timeValue": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/time"
        },
        {
          "$ref": "animation.schema.json#/$defs/timeAnimation"
        }
      ]
    }
  }
}
